# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Timezone
TIME_ZONE=UTC

# Database - PostgreSQL Configuration
DB_ENGINE=postgresql
DB_NAME=zkteco-bridge
DB_USER=your_user
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ZKTeco Device Configuration
ZKTECO_DEFAULT_PORT=4370
ZKTECO_TIMEOUT=10

# Polling Configuration
# How often to poll devices (in minutes)
POLLING_INTERVAL_MINUTES=60

# Work Hours Configuration
WORK_START_TIME=20:00
WORK_END_TIME=05:00
OVERNIGHT_SHIFT=True
OVERNIGHT_SHIFT_BUFFER_HOURS=2

# Late/Early Detection (no grace period - strict enforcement)
# LATE_CLOCK_IN_BUFFER: Hours after work start before flagging as late (e.g., 20:00 + 2hr = 22:00)
# EARLY_CLOCK_OUT_BUFFER: Hours before work end before flagging as early (e.g., 05:00 - 2hr = 03:00)
LATE_CLOCK_IN_BUFFER_HOURS=2
EARLY_CLOCK_OUT_BUFFER_HOURS=2

# Outlier Detection (for punches completely outside shift window)
# These detect anomalous punches that can't be classified as late/early (e.g., daytime punches)
OUTLIER_EARLY_CLOCK_IN_HOURS=2
OUTLIER_LATE_CLOCK_IN_HOURS=2
OUTLIER_EARLY_CLOCK_OUT_HOURS=2
OUTLIER_LATE_CLOCK_OUT_HOURS=2

# CRM Configuration
# Remote CRM API endpoint for syncing attendance
CRM_API_URL=https://your-crm-domain.com/api/attendance/
CRM_API_TOKEN=your-crm-api-token-here

# CRM Sync Configuration
CRM_SYNC_BATCH_SIZE=100
CRM_REQUEST_TIMEOUT=30
CRM_MAX_RETRIES=3


# Email Notifications for Outliers
# Set to 'true' to enable email alerts when new outlier punches are detected
OUTLIER_EMAIL_NOTIFICATIONS=false
# Comma-separated list of email addresses to receive outlier notifications
OUTLIER_EMAIL_RECIPIENTS=cmotari@unitedlegalgroup.com,hr.ke@unitedlegalgroup.com

#==============================================================================
# Email Server Configuration (required if OUTLIER_EMAIL_NOTIFICATIONS=true)
#==============================================================================
# For development, use console backend (prints emails to terminal)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production, use SMTP backend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=gmail user
EMAIL_HOST_PASSWORD=gmail app key
DEFAULT_FROM_EMAIL=cmotari@unitedlegalgroup.com

# Logging
LOG_LEVEL=INFO

# Default timezone for devices (used when device timestamps are in device-local time)
# Example: Africa/Nairobi (EAT)
DEVICE_TIME_ZONE=Africa/Nairobi
